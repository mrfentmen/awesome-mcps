{
  "name": "wikidata-mcp",
  "version": "1.0.0",
  "description": "Use this MCP server to Wikidata entity search and bounded structured knowledge queries. Tools include search entities, get entity, query knowledge",
  "type": "module",
  "mcpName": "io.github.mrfentmen/wikidata-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/wikidata-mcp.git"
  },
  "bin": {
    "wikidata-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "server.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js"
  },
  "keywords": [
    "mcp",
    "public-data",
    "wikidata"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
