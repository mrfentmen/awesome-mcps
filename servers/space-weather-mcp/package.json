{
  "name": "space-weather-mcp",
  "version": "1.0.0",
  "description": "Use this MCP server to NOAA solar wind, geomagnetic scales, and space weather alerts. Tools include get solar wind, get noaa scales, get alerts",
  "type": "module",
  "mcpName": "io.github.mrfentmen/space-weather-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/space-weather-mcp.git"
  },
  "bin": {
    "space-weather-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "server.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js"
  },
  "keywords": [
    "mcp",
    "space-weather",
    "noaa",
    "solar"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
