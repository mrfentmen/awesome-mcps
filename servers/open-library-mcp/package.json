{
  "name": "open-library-mcp",
  "version": "1.0.0",
  "description": "Use this MCP server to Open Library books, authors, works, editions, and subjects. Tools include search books, get work, get author",
  "type": "module",
  "mcpName": "io.github.mrfentmen/open-library-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrfentmen/open-library-mcp.git"
  },
  "bin": {
    "open-library-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "server.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js"
  },
  "keywords": [
    "mcp",
    "books",
    "library",
    "open-library"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
